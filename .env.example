# =============================================================================
# Campus Placement & Internship Portal — Environment Variable Template
# =============================================================================
#
# HOW TO USE LOCALLY:
#   1. Copy this file:   copy .env.example .env
#   2. Fill in your real values in .env
#   3. NEVER commit .env to Git — it is listed in .gitignore
#
# Set for a single PowerShell session (Windows):
#   $env:DB_URL      = "jdbc:mysql://..."
#   $env:DB_USERNAME = "avnadmin"
#   $env:DB_PASSWORD = "your_password_here"
#   mvn tomcat7:run
#
# HOW TO USE ON RAILWAY:
#   Go to your Railway project → Variables tab → add each key below.
#   Railway injects PORT automatically — you do NOT set PORT yourself.
# =============================================================================

# ── Database (Aiven MySQL) ───────────────────────────────────────────────────
# Full JDBC connection URL. Keep all query parameters exactly as shown.
DB_URL=jdbc:mysql://YOUR_HOST:YOUR_PORT/YOUR_DATABASE?sslMode=REQUIRED&serverTimezone=UTC&connectTimeout=15000&socketTimeout=60000

# Database login credentials
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# ── Port (managed automatically on Railway) ──────────────────────────────────
# Railway injects this variable automatically. You only need to set it
# if running locally with docker run and want a non-default port.
# PORT=8080
